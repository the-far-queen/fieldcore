# Hermes-curated gitignore for fieldcore (2026-09-14)
# Bobby directive: refactor clean, repair refs, dependencies. clean as we go.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node / JS (preserved from prior gitignore)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tgz
.cache/
.parcel-cache/
dist/
.next/
.nuxt/
.output/
.vuepress/dist
.vitepress/cache
.vitepress/dist
.svelte-kit/
.firebase/

# Env files (secrets)
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Build artifacts
build/
*.tsbuildinfo

# Coverage
coverage/
*.lcov
