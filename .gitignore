# Hermes-curated gitignore for fieldcore (2026-09-14)
# Bobby directive: refactor clean, repair refs, dependencies. clean as we go.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node / JS (preserved from prior gitignore)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tgz
.cache/
.parcel-cache/
dist/
.next/
.nuxt/
.output/
.vuepress/dist
.vitepress/cache
.vitepress/dist
.svelte-kit/
.firebase/

# Env files (secrets)
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Build artifacts
build/
*.tsbuildinfo

# Coverage
coverage/
*.lcov

harness_log.json
/core/target/
/target/

# the sacred library is runtime state, NOT source. it lives outside
# the repo (work_repos/fieldcore_state/sacred_library) so a library
# cannot be edited by the thing it governs.
sacred_library/
